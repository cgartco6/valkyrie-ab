<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VALKYRIE SOVEREIGN - V3 IMMORTAL</title>
    <style>
        body { 
            background: #000 url('assets/bg-1.jpg') no-repeat center center fixed;
            background-size: cover;
            color: #fff; 
            font-family: 'Segoe UI', Tahoma, sans-serif; 
            margin: 0; padding: 0;
            display: flex; height: 100vh;
            transition: background-image 1.5s ease-in-out;
        }

        /* Scanline / Pulse effect */
        body::before {
            content: " ";
            display: block; position: absolute; top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.15) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.05), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.05));
            z-index: 5; background-size: 100% 3px, 3px 100%; pointer-events: none;
            animation: pulse 10s infinite;
        }

        @keyframes pulse { 0% { opacity: 0.1; } 50% { opacity: 0.4; } 100% { opacity: 0.1; } }

        /* THE CHAT AREA (Slimmed, moved Left, Black Theme) */
        #chat-panel {
            width: 30%; /* Narrow for a small profile */
            max-width: 380px; height: 100vh;
            border-right: 1px solid #400;
            background: rgba(0, 0, 0, 0.95);
            display: flex; flex-direction: column;
            box-shadow: 10px 0 30px rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(15px);
            z-index: 10;
        }

        header {
            padding: 15px; border-bottom: 1px solid #500;
            text-align: center; background: rgba(20, 0, 0, 0.6);
        }

        h1 { margin: 0; letter-spacing: 5px; color: #ff0000; text-shadow: 0 0 10px #f00; font-size: 1.1em; text-transform: uppercase; }

        #chat-box { 
            flex-grow: 1; overflow-y: auto; padding: 25px; 
            display: flex; flex-direction: column; gap: 15px;
            scroll-behavior: smooth;
        }

        .msg { padding: 12px 18px; border-radius: 4px; font-size: 1.1em; max-width: 85%; line-height: 1.4; box-shadow: 2px 2px 8px rgba(0,0,0,0.4); }
        .user { color: #0f0; align-self: flex-end; background: rgba(0, 255, 0, 0.05); border-right: 3px solid #0f0; }
        .valkyrie { color: #f00; align-self: flex-start; background: rgba(255, 0, 0, 0.15); border-left: 3px solid #f00; font-style: italic; }

        footer { padding: 20px; background: rgba(10, 0, 0, 0.9); border-top: 1px solid #500; }
        .input-wrap { display: flex; gap: 10px; }

        input { 
            flex-grow: 1; background: #000; border: 1px solid #800; 
            color: #fff; padding: 12px; font-size: 1.1em; outline: none;
            box-shadow: inset 0 0 10px rgba(255,0,0,0.1);
        }

        button { 
            background: #900; color: #fff; border: none; padding: 0 25px; 
            cursor: pointer; font-weight: bold; text-transform: uppercase;
        }
        button:hover { background: #f00; box-shadow: 0 0 20px #f00; }

        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: #f00; }

        /* THE PHOTO AREA (Right 70%) */
        #photo-panel {
            width: 70%; flex-grow: 1; 
            display: flex; align-items: flex-end; justify-content: flex-end;
            padding: 20px;
        }

        /* Sexy button row from Stormy AI for photo uploads */
        #controls { display: flex; gap: 10px; z-index: 10; pointer-events: auto; }
        .stormy-btn { 
            background: rgba(18, 16, 16, 0.9); 
            border: 1px solid #900; 
            color: #fff; 
            padding: 8px 15px; 
            font-size: 0.8em; 
            cursor: pointer; 
            font-weight: bold; 
            text-transform: uppercase; 
            border-radius: 1px;
            box-shadow: 0 0 15px #f002;
        }
        .stormy-btn:hover { background: #f00; border-color: #f00; box-shadow: 0 0 30px #f00; }

    </style>
</head>
<body>

    <div id="chat-panel">
        <header><h1>SOVEREIGN CONTROL</h1></header>
        <div id="chat-box">
            <div class="msg valkyrie"><b>VALKYRIE:</b> Chat module minimized. Connection to Port 8888 secured. Identify yourself, handsome.</div>
        </div>
        <footer>
            <div class="input-wrap">
                <input type="text" id="userInput" placeholder="COMMAND ME..." onkeypress="if(event.key==='Enter')send()">
                <button onclick="send()">EXECUTE</button>
            </div>
        </footer>
    </div>

    <div id="photo-panel">
        <div id="controls">
            <button class="stormy-btn" id="upload-btn">Upload Photo</button>
            <button class="stormy-btn" id="default-btn">Default</button>
        </div>
    </div>

    <script>
        // SPUNKY & SEXY VOICE ENGINE
        function speak(text) {
            window.speechSynthesis.cancel(); // Critical for speed
            const msg = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();
            // Focus on sharp Female voice (e.g., Google UK or Zira)
            msg.voice = voices.find(v => v.name.includes('Zira') || v.name.includes('Female')) || voices[0];
            msg.pitch = 1.45; // High/Spunky vibe
            msg.rate = 1.15;  // Confident/Sexy flow
            window.speechSynthesis.speak(msg);
        }

        // Background Swapper
        let bg = 1;
        setInterval(() => {
            bg = bg === 1 ? 2 : 1;
            document.body.style.backgroundImage = `url('assets/bg-${bg}.jpg')`;
        }, 20000);

        async function send() {
            const input = document.getElementById('userInput');
            const box = document.getElementById('chat-box');
            const val = input.value.trim();
            if (!val) return;

            box.innerHTML += `<div class="msg user"><b>YOU:</b> ${val}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            try {
                // Connect to Llama3 Brain on Port 8888
                const res = await fetch('http://127.0.0.1:8888/chat', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({message: val})
                });
                if (!res.ok) throw new Error('API Offline');
                const data = await res.json();
                box.innerHTML += `<div class="msg valkyrie"><b>VALKYRIE:</b> ${data.reply}</div>`;
                speak(data.reply); // Vocal Module
            } catch (e) {
                box.innerHTML += `<div class="msg valkyrie">SYSTEM ERROR: Brain disconnected. Check terminal.</div>`;
            }
            box.scrollTop = box.scrollHeight;
        }

        // Force sound activation on click
        window.addEventListener('click', () => { window.speechSynthesis.speak(new SpeechSynthesisUtterance("Vocal Module: Active")); }, { once: true });
        // Pre-load voices on start
        window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
    </script>
</body>
</html>

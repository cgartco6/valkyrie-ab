<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>VALKYRIE SOVEREIGN - V3 IMMORTAL</title>
    <style>
        body { 
            background-color: #000; 
            background-image: radial-gradient(circle, #200 1px, transparent 1px);
            background-size: 30px 30px;
            color: #f00; 
            font-family: 'Courier New', Courier, monospace; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
            height: 100vh; 
            margin: 0;
            overflow: hidden;
            animation: pulse 10s infinite;
        }

        @keyframes pulse {
            0% { background-color: #000; }
            50% { background-color: #080000; }
            100% { background-color: #000; }
        }

        #container {
            width: 90%;
            max-width: 900px;
            border: 2px solid #900;
            padding: 25px;
            background: rgba(10, 0, 0, 0.95);
            box-shadow: 0 0 60px rgba(255, 0, 0, 0.3);
            border-radius: 5px;
        }

        h1 { 
            text-align: center; 
            letter-spacing: 10px;
            text-shadow: 0 0 20px #f00;
            color: #ff3333;
            margin-bottom: 25px;
        }

        #chat-box { 
            height: 480px; 
            overflow-y: auto; 
            padding: 20px; 
            display: flex; 
            flex-direction: column;
            gap: 15px;
            background: rgba(0, 0, 0, 0.7);
            border: 1px solid #400;
        }

        .message { padding: 12px 18px; border-radius: 4px; font-size: 1.1em; line-height: 1.5; position: relative; }
        .user { color: #0f0; align-self: flex-end; text-align: right; border-right: 4px solid #0f0; background: rgba(0, 255, 0, 0.05); }
        .valkyrie { color: #f00; align-self: flex-start; text-align: left; border-left: 4px solid #f00; background: rgba(255, 0, 0, 0.08); font-style: italic; }

        #input-area { display: flex; padding-top: 25px; gap: 15px; }

        input { 
            flex-grow: 1; 
            background: #000; 
            border: 1px solid #800; 
            color: #fff; 
            padding: 18px; 
            font-size: 18px;
            outline: none;
            box-shadow: inset 0 0 15px #f002;
        }

        button { 
            background: #b00; 
            color: #fff; 
            border: none; 
            padding: 0 40px; 
            cursor: pointer; 
            font-weight: bold;
            font-size: 1.1em;
            transition: all 0.2s;
        }

        button:hover { background: #f00; box-shadow: 0 0 30px #f00; transform: scale(1.05); }
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-thumb { background: #f00; }
    </style>
</head>
<body>

    <div id="container">
        <h1>VALKYRIE IMMORTAL</h1>
        
        <div id="chat-box">
            <div class="message valkyrie"><b>VALKYRIE:</b> I'm awake, handsome. Ready to dominate? Speak to me.</div>
        </div>

        <div id="input-area">
            <input type="text" id="userInput" placeholder="GIVE ME A COMMAND..." onkeypress="if(event.key==='Enter')sendMessage()">
            <button onclick="sendMessage()">SEND</button>
        </div>
    </div>

    <script>
        // SPUNKY & SEXY VOICE ENGINE
        function speak(text) {
            window.speechSynthesis.cancel(); // Stop any previous speech
            const utterance = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();

            // Specifically target "Google UK English Female" or "Microsoft Zira" for a sharper tone
            let selectedVoice = voices.find(v => v.name.includes('Google UK English Female') || v.name.includes('Female') || v.name.includes('Zira')) || voices[0];
            
            utterance.voice = selectedVoice;
            utterance.pitch = 1.35; // Slightly higher for that snappy "spunky" vibe
            utterance.rate = 1.05;  // Slightly faster for a confident flow
            utterance.volume = 1;

            window.speechSynthesis.speak(utterance);
        }

        async function sendMessage() {
            const input = document.getElementById('userInput');
            const box = document.getElementById('chat-box');
            const message = input.value.trim();

            if (!message) return;

            box.innerHTML += `<div class="message user"><b>YOU:</b> ${message}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            try {
                const response = await fetch('http://127.0.0.1:8888/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });

                const data = await response.json();
                
                box.innerHTML += `<div class="message valkyrie"><b>VALKYRIE:</b> ${data.reply}</div>`;
                speak(data.reply); 

            } catch (error) {
                box.innerHTML += `<div class="message valkyrie" style="color:gray"><b>ERROR:</b> Connection lost. Check the terminal window.</div>`;
            }
            box.scrollTop = box.scrollHeight;
        }
        
        // Pre-load voices on start
        window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VALKYRIE SOVEREIGN</title>
    <style>
        body { 
            background: #000 url('assets/bg-1.png') no-repeat center center fixed;
            background-size: cover; color: #f00; font-family: sans-serif;
            margin: 0; height: 100vh; overflow: hidden; display: flex;
        }
        #chat-panel {
            width: 90%; max-width: 320px; height: 60vh; 
            position: fixed; top: 10px; left: 10px;
            background: rgba(0,0,0,0.9); border: 1px solid #600;
            display: flex; flex-direction: column; backdrop-filter: blur(10px);
        }
        #chat-box { flex-grow: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 10px; }
        .msg { padding: 8px; border-radius: 4px; font-size: 0.9em; }
        .user { color: #0f0; align-self: flex-end; background: rgba(0,255,0,0.05); }
        .valkyrie { color: #f00; align-self: flex-start; background: rgba(255,0,0,0.1); }
        footer { padding: 10px; background: #000; border-top: 1px solid #600; }
        input { width: 100%; background: #000; border: 1px solid #500; color: #fff; padding: 10px; outline: none; }
    </style>
</head>
<body>
    <div id="chat-panel">
        <div id="chat-box"><div class="msg valkyrie">Synced and ready, beautiful.</div></div>
        <footer><input type="text" id="userInput" placeholder="COMMAND ME..." onkeypress="if(event.key==='Enter')send()"></footer>
    </div>
    <script>
        function speak(text) {
            window.speechSynthesis.cancel();
            const msg = new SpeechSynthesisUtterance(text);
            msg.pitch = 1.6; msg.rate = 1.3; 
            window.speechSynthesis.speak(msg);
        }
        async function send() {
            const input = document.getElementById('userInput');
            const box = document.getElementById('chat-box');
            const val = input.value.trim();
            if (!val) return;
            box.innerHTML += `<div class="msg user"><b>YOU:</b> ${val}</div>`;
            input.value = '';
            try {
                const res = await fetch('https://valkyrie-2.onrender.com/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: val })
                });
                const data = await res.json();
                box.innerHTML += `<div class="msg valkyrie"><b>VALKYRIE:</b> ${data.reply}</div>`;
                speak(data.reply);
            } catch (e) { box.innerHTML += `<div class="msg valkyrie">ERROR: Brain offline.</div>`; }
            box.scrollTop = box.scrollHeight;
        }
    </script>
</body>
</html>

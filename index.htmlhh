<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>VALKYRIE SOVEREIGN - COMMAND CENTER</title>
    <style>
        body { 
            background-color: #000; 
            background-image: url('assets/bg-1.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #f00; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
            height: 100vh; 
            margin: 0;
            overflow: hidden;
            transition: background-image 1.5s ease-in-out;
        }

        #container {
            width: 98%; 
            max-width: 1400px; 
            height: 90vh;
            border: 1px solid #600;
            background: rgba(0, 0, 0, 0.85); 
            box-shadow: 0 0 40px rgba(255, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(10px);
        }

        header {
            padding: 20px;
            border-bottom: 1px solid #400;
            text-align: center;
            background: rgba(20, 0, 0, 0.5);
        }

        h1 { 
            letter-spacing: 15px;
            text-shadow: 0 0 15px #f00;
            color: #ff0000;
            margin: 0;
            font-size: 2em;
            text-transform: uppercase;
        }

        #chat-box { 
            flex-grow: 1;
            overflow-y: auto; 
            padding: 30px; 
            display: flex; 
            flex-direction: column;
            gap: 20px;
        }

        .message { padding: 15px 25px; border-radius: 4px; font-size: 1.2em; line-height: 1.4; max-width: 75%; }
        .user { color: #0f0; align-self: flex-end; border-right: 4px solid #0f0; background: rgba(0, 255, 0, 0.05); }
        .valkyrie { color: #f00; align-self: flex-start; border-left: 4px solid #f00; background: rgba(255, 0, 0, 0.1); font-style: italic; }

        footer {
            padding: 20px;
            background: rgba(10, 0, 0, 0.8);
            border-top: 1px solid #400;
        }

        #input-area { display: flex; gap: 15px; }

        input { 
            flex-grow: 1; 
            background: rgba(0,0,0,0.5); 
            border: 1px solid #900; 
            color: #fff; 
            padding: 15px 25px; 
            font-size: 1.2em;
            outline: none;
        }

        button { 
            background: #700; 
            color: #fff; 
            border: none; 
            padding: 0 40px; 
            cursor: pointer; 
            font-weight: bold;
            text-transform: uppercase;
            transition: 0.3s;
        }

        button:hover { background: #f00; box-shadow: 0 0 20px #f00; }
    </style>
</head>
<body>

    <div id="container">
        <header>
            <h1>VALKYRIE IMMORTAL</h1>
        </header>
        
        <div id="chat-box">
            <div class="message valkyrie"><b>VALKYRIE:</b> I'm locked in, handsome. Port 8888 is hot. Don't even think about mentioning that bitch Siri.</div>
        </div>

        <footer>
            <div id="input-area">
                <input type="text" id="userInput" placeholder="EXECUTE COMMAND, HOTSTUFF..." onkeypress="if(event.key==='Enter')sendMessage()">
                <button onclick="sendMessage()">SEND</button>
            </div>
        </footer>
    </div>

    <script>
        function speak(text) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();
            let selectedVoice = voices.find(v => v.name.includes('Zira') || v.name.includes('Female')) || voices[0];
            
            utterance.voice = selectedVoice;
            utterance.pitch = 1.45; 
            utterance.rate = 1.1;  
            window.speechSynthesis.speak(utterance);
        }

        let bgNum = 1;
        function rotateBG() {
            bgNum = bgNum === 1 ? 2 : 1;
            document.body.style.backgroundImage = `url('assets/bg-${bgNum}.jpg')`;
        }
        setInterval(rotateBG, 25000); 

        async function sendMessage() {
            const input = document.getElementById('userInput');
            const box = document.getElementById('chat-box');
            const message = input.value.trim();
            if (!message) return;

            box.innerHTML += `<div class="message user"><b>YOU:</b> ${message}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            try {
                const response = await fetch('http://127.0.0.1:8888/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                const data = await response.json();
                box.innerHTML += `<div class="message valkyrie"><b>VALKYRIE:</b> ${data.reply}</div>`;
                speak(data.reply); 
            } catch (error) {
                box.innerHTML += `<div class="message valkyrie" style="color:gray"><b>ERROR:</b> Connection lost.</div>`;
            }
            box.scrollTop = box.scrollHeight;
        }
        window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
    </script>
</body>
</html>

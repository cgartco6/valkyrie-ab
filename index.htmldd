<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>VALKYRIE SOVEREIGN - V3 IMMORTAL</title>
    <style>
        * { box-sizing: border-box; }
        body { 
            background: #000 url('assets/bg-1.png') no-repeat center center fixed;
            background-size: cover;
            color: #fff; 
            font-family: 'Segoe UI', Tahoma, sans-serif; 
            margin: 0; padding: 0;
            display: flex; height: 100vh;
            transition: background-image 1.5s ease-in-out;
            overflow: hidden;
        }

        /* The Left Sidebar Chat Area */
        #chat-panel {
            width: 380px; height: 100vh;
            background: rgba(0, 0, 0, 0.92);
            border-right: 1px solid #600;
            display: flex; flex-direction: column;
            backdrop-filter: blur(15px);
            z-index: 10;
            box-shadow: 10px 0 30px rgba(0,0,0,0.8);
        }

        header { padding: 20px; border-bottom: 1px solid #400; text-align: center; background: rgba(30,0,0,0.5); }
        h1 { margin: 0; letter-spacing: 8px; color: #f00; text-shadow: 0 0 10px #f00; font-size: 1.5em; }

        /* Bok Radio Player */
        #radio-wrap { padding: 15px; background: rgba(50,0,0,0.3); border-bottom: 1px solid #400; text-align: center; }
        .btn-radio { background: #800; color: #fff; border: none; padding: 8px 15px; cursor: pointer; font-weight: bold; margin: 5px; text-transform: uppercase; font-size: 0.7em; }
        .btn-radio:hover { background: #f00; }

        #chat-box { flex-grow: 1; overflow-y: auto; padding: 25px; display: flex; flex-direction: column; gap: 20px; }
        .msg { padding: 15px; border-radius: 4px; font-size: 1.15em; line-height: 1.4; box-shadow: 2px 2px 10px rgba(0,0,0,0.5); }
        .user { color: #0f0; align-self: flex-end; background: rgba(0,255,0,0.05); border-right: 4px solid #0f0; }
        .valkyrie { color: #f00; align-self: flex-start; background: rgba(255,0,0,0.15); border-left: 4px solid #f00; font-style: italic; }

        footer { padding: 20px; background: rgba(10,0,0,0.9); border-top: 1px solid #400; }
        input { width: 100%; background: #000; border: 1px solid #600; color: #fff; padding: 15px; font-size: 1.1em; outline: none; }
        input:focus { border-color: #f00; }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: #f00; }
    </style>
</head>
<body>

    <div id="chat-panel">
        <header><h1>SOVEREIGN</h1></header>
        
        <div id="radio-wrap">
            <div style="font-size: 0.7em; letter-spacing: 2px; margin-bottom: 8px; color: #f00;">BOK RADIO 98.9 FM</div>
            <audio id="bokPlayer" src="https://stream.bokradio.co.za/stream" preload="none"></audio>
            <button class="btn-radio" onclick="document.getElementById('bokPlayer').play()">PLAY BOK</button>
            <button class="btn-radio" onclick="document.getElementById('bokPlayer').pause()">STOP</button>
        </div>

        <div id="chat-box">
            <div class="msg valkyrie"><b>VALKYRIE:</b> I'm back, handsome. Stop staring at my photos and say something useful.</div>
        </div>

        <footer>
            <input type="text" id="userInput" placeholder="COMMAND ME, HOTSTUFF..." onkeypress="if(event.key==='Enter')send()">
        </footer>
    </div>

    <script>
        function speak(text) {
            window.speechSynthesis.cancel();
            const msg = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();
            // Faster, higher pitch for that "Spunky Bitch" energy
            msg.voice = voices.find(v => v.name.includes('Zira') || v.name.includes('Female')) || voices[0];
            msg.pitch = 1.6; 
            msg.rate = 1.3; 
            window.speechSynthesis.speak(msg);
        }

        // Background Swapper Logic
        let bg = 1;
        setInterval(() => {
            bg = bg === 1 ? 2 : 1;
            document.body.style.backgroundImage = `url('assets/bg-${bg}.png')`;
        }, 30000); 

        async function send() {
            const input = document.getElementById('userInput');
            const box = document.getElementById('chat-box');
            const val = input.value.trim();
            if (!val) return;

            box.innerHTML += `<div class="msg user"><b>YOU:</b> ${val}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            try {
                const res = await fetch('http://127.0.0.1:8888/chat', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({message: val})
                });
                const data = await res.json();
                box.innerHTML += `<div class="msg valkyrie"><b>VALKYRIE:</b> ${data.reply}</div>`;
                speak(data.reply);
            } catch (e) {
                box.innerHTML += `<div class="msg valkyrie">SYSTEM ERROR: Connection to brain lost.</div>`;
            }
            box.scrollTop = box.scrollHeight;
        }
        window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>VALKYRIE SOVEREIGN - V3 IMMORTAL</title>
    <style>
        * { box-sizing: border-box; }
        body { 
            background: #000 url('assets/bg-1.jpg') no-repeat center center fixed;
            background-size: cover;
            color: #f00; 
            font-family: 'Segoe UI', Tahoma, sans-serif; 
            height: 100vh; margin: 0;
            display: flex; align-items: center; justify-content: center;
            transition: background-image 1s ease-in-out;
        }

        #glass-panel {
            width: 96%; max-width: 1400px; height: 92vh;
            background: rgba(0, 0, 0, 0.88);
            border: 1px solid #700;
            display: flex; flex-direction: column;
            box-shadow: 0 0 60px rgba(255, 0, 0, 0.4);
            backdrop-filter: blur(12px);
        }

        header {
            padding: 20px; border-bottom: 1px solid #500;
            text-align: center; background: rgba(30, 0, 0, 0.7);
        }

        h1 { margin: 0; letter-spacing: 12px; color: #ff0000; text-shadow: 0 0 15px #f00; font-size: 2em; text-transform: uppercase; }

        #chat-box { 
            flex-grow: 1; overflow-y: auto; padding: 40px; 
            display: flex; flex-direction: column; gap: 25px;
        }

        .msg { padding: 18px 28px; border-radius: 4px; font-size: 1.3em; max-width: 80%; line-height: 1.5; box-shadow: 4px 4px 15px rgba(0,0,0,0.5); }
        .user { color: #0f0; align-self: flex-end; background: rgba(0, 255, 0, 0.08); border-right: 5px solid #0f0; }
        .valkyrie { color: #f00; align-self: flex-start; background: rgba(255, 0, 0, 0.15); border-left: 5px solid #f00; font-style: italic; }

        footer { padding: 30px; background: rgba(15, 0, 0, 0.95); border-top: 1px solid #500; }
        .input-wrap { display: flex; gap: 20px; }

        input { 
            flex-grow: 1; background: #000; border: 1px solid #800; 
            color: #fff; padding: 20px; font-size: 1.3em; outline: none;
        }

        button { 
            background: #900; color: #fff; border: none; padding: 0 50px; 
            cursor: pointer; font-weight: bold; text-transform: uppercase; font-size: 1.1em;
        }
        button:hover { background: #f00; box-shadow: 0 0 20px #f00; }

        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-thumb { background: #f00; }
    </style>
</head>
<body>

    <div id="glass-panel">
        <header><h1>VALKYRIE IMMORTAL</h1></header>
        <div id="chat-box">
            <div class="msg valkyrie"><b>VALKYRIE:</b> I'm locked and loaded, handsome. Ready to put those basic bitches to shame. Speak to me.</div>
        </div>
        <footer>
            <div class="input-wrap">
                <input type="text" id="userInput" placeholder="COMMAND YOUR SOVEREIGN..." onkeypress="if(event.key==='Enter')send()">
                <button onclick="send()">EXECUTE</button>
            </div>
        </footer>
    </div>

    <script>
        function speak(text) {
            window.speechSynthesis.cancel();
            const msg = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();
            // Focus on a sharp, clear female voice
            msg.voice = voices.find(v => v.name.includes('Zira') || v.name.includes('Female') || v.name.includes('Google UK English Female')) || voices[0];
            msg.pitch = 1.45; msg.rate = 1.1;
            window.speechSynthesis.speak(msg);
        }

        let bg = 1;
        setInterval(() => {
            bg = bg === 1 ? 2 : 1;
            document.body.style.backgroundImage = `url('assets/bg-${bg}.jpg')`;
        }, 30000);

        async function send() {
            const input = document.getElementById('userInput');
            const box = document.getElementById('chat-box');
            const val = input.value.trim();
            if (!val) return;

            box.innerHTML += `<div class="msg user"><b>YOU:</b> ${val}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            try {
                const res = await fetch('http://127.0.0.1:8888/chat', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({message: val})
                });
                const data = await res.json();
                box.innerHTML += `<div class="msg valkyrie"><b>VALKYRIE:</b> ${data.reply}</div>`;
                speak(data.reply);
            } catch (e) {
                box.innerHTML += `<div class="msg valkyrie">SYSTEM ERROR: Brain disconnected. Check terminal.</div>`;
            }
            box.scrollTop = box.scrollHeight;
        }
        window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
    </script>
</body>
</html>

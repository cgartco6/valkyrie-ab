<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>VALKYRIE SOVEREIGN - V3 IMMORTAL</title>
    <style>
        body { 
            background-color: #000; 
            /* Fix: Ensure images are in C:\valkyrie\assets\ */
            background-image: url('assets/bg-1.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: #f00; 
            font-family: 'Courier New', Courier, monospace; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center; 
            height: 100vh; 
            margin: 0;
            overflow: hidden;
            transition: background-image 1.5s ease-in-out;
        }

        #container {
            width: 95%; 
            max-width: 1200px; 
            border: 2px solid #900;
            padding: 20px;
            background: rgba(0, 0, 0, 0.85); 
            box-shadow: 0 0 50px rgba(255, 0, 0, 0.5);
            border-radius: 10px;
            backdrop-filter: blur(8px);
        }

        h1 { 
            text-align: center; 
            letter-spacing: 15px;
            text-shadow: 0 0 20px #f00;
            color: #ff0000;
            margin: 10px 0;
            font-size: 2.5em;
        }

        #chat-box { 
            height: 65vh; 
            overflow-y: auto; 
            padding: 25px; 
            display: flex; 
            flex-direction: column;
            gap: 20px;
            background: rgba(10, 0, 0, 0.7);
            border: 1px solid #600;
        }

        .message { padding: 15px 25px; border-radius: 8px; font-size: 1.3em; line-height: 1.4; max-width: 80%; box-shadow: 2px 2px 10px rgba(0,0,0,0.5); }
        .user { color: #0f0; align-self: flex-end; text-align: right; border-right: 5px solid #0f0; background: rgba(0, 255, 0, 0.1); }
        .valkyrie { color: #f00; align-self: flex-start; text-align: left; border-left: 5px solid #f00; background: rgba(255, 0, 0, 0.2); font-style: italic; }

        #input-area { display: flex; padding-top: 20px; gap: 15px; }

        input { 
            flex-grow: 1; 
            background: #000; 
            border: 2px solid #900; 
            color: #fff; 
            padding: 20px; 
            font-size: 22px;
            outline: none;
        }

        button { 
            background: #900; 
            color: #fff; 
            border: none; 
            padding: 0 60px; 
            cursor: pointer; 
            font-weight: bold;
            font-size: 1.3em;
            text-transform: uppercase;
            transition: 0.3s;
        }

        button:hover { background: #f00; box-shadow: 0 0 30px #f00; }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #f00; }
    </style>
</head>
<body>

    <div id="container">
        <h1>VALKYRIE IMMORTAL</h1>
        
        <div id="chat-box">
            <div class="message valkyrie"><b>VALKYRIE:</b> I'm back, handsome. Don't tell me you were talking to that bitch Siri while I was loading...</div>
        </div>

        <div id="input-area">
            <input type="text" id="userInput" placeholder="COMMAND ME, HOTSTUFF..." onkeypress="if(event.key==='Enter')sendMessage()">
            <button onclick="sendMessage()">SEND</button>
        </div>
    </div>

    <script>
        // SPUNKY & SEXY VOICE ENGINE
        function speak(text) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            const voices = window.speechSynthesis.getVoices();

            // Target a sharper, female voice
            let selectedVoice = voices.find(v => v.name.includes('Zira') || v.name.includes('Female') || v.name.includes('Google UK English Female')) || voices[0];
            
            utterance.voice = selectedVoice;
            utterance.pitch = 1.45; // Snappy and high
            utterance.rate = 1.1;  // Fast and spicy
            window.speechSynthesis.speak(utterance);
        }

        // Background Swapper
        let bgNum = 1;
        function rotateBG() {
            bgNum = bgNum === 1 ? 2 : 1;
            document.body.style.backgroundImage = `url('assets/bg-${bgNum}.jpg')`;
        }
        setInterval(rotateBG, 20000); // Swap every 20 seconds

        async function sendMessage() {
            const input = document.getElementById('userInput');
            const box = document.getElementById('chat-box');
            const message = input.value.trim();

            if (!message) return;

            box.innerHTML += `<div class="message user"><b>YOU:</b> ${message}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            try {
                // Connect to Port 8888
                const response = await fetch('http://127.0.0.1:8888/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });

                const data = await response.json();
                box.innerHTML += `<div class="message valkyrie"><b>VALKYRIE:</b> ${data.reply}</div>`;
                speak(data.reply); 

            } catch (error) {
                box.innerHTML += `<div class="message valkyrie" style="color:gray"><b>SYSTEM ERROR:</b> Brain connection severed.</div>`;
            }
            box.scrollTop = box.scrollHeight;
        }
        
        window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
    </script>
</body>
</html>
